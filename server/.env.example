# Copy this file to server/.env and fill it in. NEVER commit server/.env.

PORT=4000
WEB_ORIGIN=http://localhost:3000
# Production only: share the login cookie across subdomains, e.g. .yourdomain.com
# COOKIE_DOMAIN=.yourdomain.com

# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-change-me

# --- AI ---------------------------------------------------------------
# Get a key at https://console.anthropic.com  (this is billed per use, separately from a claude.ai plan)
ANTHROPIC_API_KEY=
# Check the model id in Anthropic's docs if you want a different one
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=16000
MAX_AGENT_TURNS=60
# Lets the Research Agent use Anthropic's web search tool (must be enabled for your Anthropic org; extra cost)
ENABLE_WEB_SEARCH=false
# true = run the full pipeline with sample content and NO Claude calls (for testing the app)
MOCK_AI=false

# --- Pictures (optional) -----------------------------------------------
# AI pictures for covers and chapters. Each picture costs money on the provider's side. Leave blank to use only the
# built-in drawn artwork (free). Keys go ONLY in this file, never in chat or in a zip.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: force a model. Leave blank and the studio picks the best one your account can use.
# OPENAI_IMAGE_MODEL=
# GEMINI_IMAGE_MODEL=

# --- Credits / pricing --------------------------------------------------
SIGNUP_CREDITS=1
PROJECT_CREDIT_COST=1
MAX_RUNS_PER_PROJECT=25
# credits:price_in_INR, comma separated. SET THESE ONLY AFTER you measure your real cost per book.
CREDIT_PACKS=1:499,5:1999,12:3999

# --- Razorpay (optional; untested with live keys) -----------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local testing only: lets a signed-in user add free credits from the dashboard. Ignored when NODE_ENV=production.
DEV_GRANT=true
